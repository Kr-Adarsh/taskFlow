LLM_MAX_OUTPUT_TOKENS=2048
LLM_REASONING_EFFORT=medium
TASKFLOW_RUN_DEADLINE_SECONDS=600
TASKFLOW_WORKSPACE_URL=http://127.0.0.1:8000
TASKFLOW_CHROME_PATH=/usr/bin/google-chrome
